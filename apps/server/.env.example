# Server
PORT=4000 #Port the Express server runs on
CLIENT_URL=http://localhost:3000 #URL of the client app (CORS / trusted origins)

# Database
DATABASE_URL= #Your database connection string, you can get this from your database provider

# Better Auth
BETTER_AUTH_URL=http://localhost:4000 #The URL where your authentication server is running
BETTER_AUTH_SECRET= #Generate a random string for this; it's used to sign/encrypt session cookies

# Google OAuth
GOOGLE_CLIENT_ID= #You can get this from the Google Cloud Console
GOOGLE_CLIENT_SECRET= #You can get this from the Google Cloud Console

# SMTP (used to send OTP emails)
SMTP_HOST= #e.g. smtp.gmail.com
SMTP_PORT=587 #Usually 587 for TLS or 465 for SSL
SMTP_USER= #Your SMTP username/email
SMTP_PASS= #Your SMTP password or app password
